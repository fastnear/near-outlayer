# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by scripts/build-llms.mjs, which `npm run build` runs via the prebuild hook.
#
# These are derived from the repository's markdown, so tracking them meant every build
# rewrote a checked-in file and left the tree dirty — which then made the next `git pull`
# on a deploy host abort. They are regenerated before every build; nothing serves them
# without one. Edit scripts/llms-manifest.mjs or the source markdown, never these files.
/public/llms.txt
/public/llms-full.txt
